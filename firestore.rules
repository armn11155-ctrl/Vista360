rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── FIX SEGURIDAD: usar Custom Claims en lugar de allowlist hardcodeada ──
    //
    // Para autorizar un usuario desde Firebase Admin SDK:
    //   await admin.auth().setCustomUserClaims(uid, { role: 'admin' });
    //
    // El claim se propaga en el siguiente token refresh (~1h) o forzando:
    //   await firebase.auth().currentUser.getIdToken(true);
    //
    function isAllowed() {
      return request.auth != null
        && request.auth.token.role == 'admin';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Colecciones de negocio (requieren rol admin) ───────────────────────
    match /paneles/{id} {
      allow read: if isSignedIn();
      allow write: if isAllowed();
    }

    match /clientes/{id} {
      allow read: if isSignedIn();
      allow write: if isAllowed();
    }

    match /contratos/{id} {
      allow read: if isSignedIn();
      allow write: if isAllowed();
    }

    match /gastos/{id} {
      allow read: if isSignedIn();
      allow write: if isAllowed();
    }

    match /proveedores/{id} {
      allow read: if isSignedIn();
      allow write: if isAllowed();
    }

    match /facturas/{id} {
      allow read: if isSignedIn();
      allow write: if isAllowed();
    }

    match /sueldos/{id} {
      allow read: if isAllowed();
      allow write: if isAllowed();
    }

    // ── Solicitudes desde la web pública (sin login) ───────────────────────
    // El formulario de contacto del sitio web escribe aquí directamente.
    // Solo permite CREAR, con datos validados estrictamente. Nadie puede
    // leer, editar ni borrar sin ser admin — así un atacante no puede ver
    // ni alterar solicitudes ajenas, solo "tirar" documentos nuevos (y la
    // validación de campos + tamaños limita el daño de eso).
    function esSolicitudValida(d) {
      return d.keys().hasOnly(
              ['contacto','empresa','celular','email','panelInteres','notas',
               'tipo','estado','origen','createdAt','hp']
            )
        && d.contacto is string    && d.contacto.size()  > 0 && d.contacto.size()  <= 80
        && d.empresa  is string    && d.empresa.size()   > 0 && d.empresa.size()   <= 80
        && d.celular  is string    && d.celular.size()   > 0 && d.celular.size()   <= 25
        && d.email    is string    && d.email.size()     > 0 && d.email.size()     <= 100
        && d.panelInteres is string && d.panelInteres.size() <= 40
        && d.notas    is string    && d.notas.size()     <= 500
        && d.tipo     == 'Prospecto'
        && d.estado   == 'En contacto'
        && d.origen   == 'web'
        && (!('hp' in d) || d.hp == '');  // honeypot: si un bot llena este campo oculto, se rechaza
    }

    match /solicitudesWeb/{id} {
      allow read, update, delete: if isAllowed();
      allow create: if esSolicitudValida(request.resource.data);
    }

    // ── Bloqueo por defecto (deny-all) ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
