rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Permisos ────────────────────────────────────────────────────────────
    // Mientras uses una sola cuenta humana para administrar todo, "admin"
    // == estar logueado Y no ser una cuenta de cliente del portal (ver
    // isHuman() más abajo). Si en el futuro agregas más usuarios humanos
    // y quieres separar permisos entre ellos (ej: un vendedor que solo lee,
    // sin poder borrar), ahí sí conviene Custom Claims, pero hay que
    // activarlos primero desde un backend con el Admin SDK:
    //   await admin.auth().setCustomUserClaims(uid, { role: 'admin' });

    // ── Vista360-Player (portal de clientes) ───────────────────────────────
    // Cada cliente tiene una cuenta de Firebase Auth (creada por el dueño
    // con scripts/crear-acceso-cliente.mjs) vinculada a su cliente_id real
    // mediante un documento en portalUsers. isHuman() excluye explícitamente
    // a esas cuentas de cliente de TODAS las colecciones internas (gastos,
    // facturas, proveedores, otros clientes, etc.) — solo ven lo que la
    // sección de abajo les habilita explícitamente, y solo lo suyo.
    function esCuentaDePortal() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid));
    }

    function clienteIdDelPortal() {
      return get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.clienteId;
    }

    function isHuman() {
      return request.auth != null && !esCuentaDePortal();
    }

    // ── Dueño / gerente ─────────────────────────────────────────────────
    // Único(s) correo(s) con acceso a Finanzas (patrimonio, liquidez,
    // activos, deudas, fondos, objetivos). Mantener sincronizado con
    // OWNER_EMAILS en src/config/constants.ts.
    function isOwner() {
      return request.auth != null &&
        request.auth.token.email in [
          'armn.101@hotmail.com',
          'armn.11155@gmail.com'
        ];
    }

    // ── Finanzas (configuracion/capitalv2) — solo el dueño ─────────────────
    match /configuracion/{id} {
      allow read, write: if isOwner();
    }

    // ── Colecciones de negocio (admins humanos; paneles también visibles
    //    para el portal de clientes, ya que su nombre/ubicación no es
    //    sensible y el portal los necesita para mostrar campañas) ─────────
    match /paneles/{id} {
      allow read: if isHuman() || esCuentaDePortal();
      allow write: if isHuman();
    }

    match /clientes/{id} {
      allow read: if isHuman() || (esCuentaDePortal() && id == clienteIdDelPortal());
      allow write: if isHuman();
    }

    match /contratos/{id} {
      allow read: if isHuman() ||
        (esCuentaDePortal() && resource.data.cliente_id == clienteIdDelPortal());
      allow write: if isHuman();
    }

    match /gastos/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /proveedores/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /facturas/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /sueldos/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    // ── Vista360-Player: vínculo cuenta ↔ cliente ───────────────────────────
    // Solo lo crea/edita el dueño (con el script de Admin SDK). El propio
    // cliente puede leer ÚNICAMENTE su propio documento, para saber a qué
    // cliente_id corresponde apenas inicia sesión.
    match /portalUsers/{uid} {
      allow read: if isHuman() || (request.auth != null && request.auth.uid == uid);
      allow write: if isHuman();
    }

    // ── Vista360-Player: solicitudes de nueva campaña ──────────────────────
    // El cliente solo puede crear una solicitud para SU PROPIO cliente_id,
    // con datos validados, y leer las suyas. Aprobar/rechazar/convertir en
    // contrato real lo hace el dueño desde Vista360 (igual que solicitudesWeb).
    function esSolicitudCampanaValida(d) {
      return d.keys().hasOnly(
              ['cliente_id','nombre','objetivo','presupuesto','ciudades',
               'comentarios','estado','createdAt']
            )
        && d.cliente_id is string && d.cliente_id == clienteIdDelPortal()
        && d.nombre     is string && d.nombre.size()  > 0 && d.nombre.size()  <= 100
        && d.estado     == 'Pendiente';
    }

    match /solicitudesCampana/{id} {
      allow read: if isHuman() ||
        (esCuentaDePortal() && resource.data.cliente_id == clienteIdDelPortal());
      allow create: if esCuentaDePortal() && esSolicitudCampanaValida(request.resource.data);
      allow update, delete: if isHuman();
    }

    // ── Solicitudes desde la web pública (sin login) ───────────────────────
    // El formulario de contacto del sitio web escribe aquí directamente.
    // Solo permite CREAR, con datos validados estrictamente. Nadie puede
    // leer, editar ni borrar sin ser admin — así un atacante no puede ver
    // ni alterar solicitudes ajenas, solo "tirar" documentos nuevos (y la
    // validación de campos + tamaños limita el daño de eso).
    function esSolicitudValida(d) {
      return d.keys().hasOnly(
              ['contacto','empresa','celular','email','panelInteres','notas',
               'tipo','estado','origen','createdAt','hp','importado']
            )
        && d.contacto is string    && d.contacto.size()  > 0 && d.contacto.size()  <= 80
        && d.empresa  is string    && d.empresa.size()   > 0 && d.empresa.size()   <= 80
        && d.celular  is string    && d.celular.size()   > 0 && d.celular.size()   <= 25
        && d.email    is string    && d.email.size()     > 0 && d.email.size()     <= 100
        && d.panelInteres is string && d.panelInteres.size() <= 40
        && d.notas    is string    && d.notas.size()     <= 500
        && d.tipo     == 'Prospecto'
        && d.estado   == 'En contacto'
        && d.origen   == 'web'
        && (!('hp' in d) || d.hp == '');  // honeypot: si un bot llena este campo oculto, se rechaza
    }

    match /solicitudesWeb/{id} {
      allow read, update, delete: if isHuman();
      allow create: if esSolicitudValida(request.resource.data);
    }

    // ── Bloqueo por defecto (deny-all) ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
