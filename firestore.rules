rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Permisos ────────────────────────────────────────────────────────────
    // NOTA: la version anterior de esto exigia un Custom Claim
    // (request.auth.token.role == 'admin') que nunca se activo para tu
    // usuario real -> por eso se rompio "Agregar prospecto" y la lectura
    // de solicitudesWeb ("Missing or insufficient permissions"). Mientras
    // uses una sola cuenta para administrar todo, isAllowed() == estar
    // logueado es exactamente el mismo nivel de seguridad que ya tenias
    // (la regla original era "if request.auth != null" para todo).
    //
    // Si en el futuro agregas mas usuarios y quieres separar permisos
    // (ej: un vendedor que solo lee, sin poder borrar), ahi si conviene
    // volver a Custom Claims, pero hay que activarlos primero desde un
    // backend con el Admin SDK:
    //   await admin.auth().setCustomUserClaims(uid, { role: 'admin' });
    function isAllowed() {
      return request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Vista360 Player ──────────────────────────────────────────────────
    // Las pantallas/paneles físicos inician sesión de forma ANÓNIMA (no
    // hay un humano frente a ellas para escribir credenciales). isHuman()
    // excluye explícitamente esos logins anónimos de las colecciones de
    // negocio (clientes, contratos, gastos, facturas...), para que un
    // dispositivo player jamás pueda leer ni escribir datos financieros o
    // de clientes — solo accede a lo que le corresponde: su contenido
    // (contenidoDigital) y su propio estado (playersStatus).
    function isHuman() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    // ── Dueño / gerente ─────────────────────────────────────────────────
    // Único(s) correo(s) con acceso a Finanzas (patrimonio, liquidez,
    // activos, deudas, fondos, objetivos). Mantener sincronizado con
    // OWNER_EMAILS en src/config/constants.ts.
    function isOwner() {
      return request.auth != null &&
        request.auth.token.email in [
          'armn.101@hotmail.com',
          'armn.11155@gmail.com'
        ];
    }

    // ── Finanzas (configuracion/capitalv2) — solo el dueño ─────────────────
    match /configuracion/{id} {
      allow read, write: if isOwner();
    }

    // ── Colecciones de negocio (solo admins humanos — nunca players) ───────
    match /paneles/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /clientes/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /contratos/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /gastos/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /proveedores/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /facturas/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    match /sueldos/{id} {
      allow read: if isHuman();
      allow write: if isHuman();
    }

    // ── Vista360 Player: contenido asignado a cada panel ───────────────────
    // El id del documento es el panel_id. Cualquier dispositivo autenticado
    // (incluyendo el login anónimo del player) puede LEER su playlist —
    // así no hace falta una cuenta humana en cada pantalla. Solo un admin
    // humano puede crear/editar/borrar contenido.
    match /contenidoDigital/{id} {
      allow read: if isSignedIn();
      allow write: if isHuman();
    }

    // ── Vista360 Player: heartbeat de cada pantalla ─────────────────────────
    // Cada dispositivo solo puede escribir SU PROPIO documento de estado
    // (el id debe coincidir con el panel_id que reporta), y solo esos
    // campos puntuales — no puede tocar nada más. Los admins humanos
    // pueden leer todo para ver el panel de estado de pantallas.
    match /playersStatus/{id} {
      allow read: if isHuman();
      allow write: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['panel_id', 'online', 'lastSeen', 'appVersion', 'userAgent']
           )
        && request.resource.data.panel_id == id;
    }

    // ── Solicitudes desde la web pública (sin login) ───────────────────────
    // El formulario de contacto del sitio web escribe aquí directamente.
    // Solo permite CREAR, con datos validados estrictamente. Nadie puede
    // leer, editar ni borrar sin ser admin — así un atacante no puede ver
    // ni alterar solicitudes ajenas, solo "tirar" documentos nuevos (y la
    // validación de campos + tamaños limita el daño de eso).
    function esSolicitudValida(d) {
      return d.keys().hasOnly(
              ['contacto','empresa','celular','email','panelInteres','notas',
               'tipo','estado','origen','createdAt','hp','importado']
            )
        && d.contacto is string    && d.contacto.size()  > 0 && d.contacto.size()  <= 80
        && d.empresa  is string    && d.empresa.size()   > 0 && d.empresa.size()   <= 80
        && d.celular  is string    && d.celular.size()   > 0 && d.celular.size()   <= 25
        && d.email    is string    && d.email.size()     > 0 && d.email.size()     <= 100
        && d.panelInteres is string && d.panelInteres.size() <= 40
        && d.notas    is string    && d.notas.size()     <= 500
        && d.tipo     == 'Prospecto'
        && d.estado   == 'En contacto'
        && d.origen   == 'web'
        && (!('hp' in d) || d.hp == '');  // honeypot: si un bot llena este campo oculto, se rechaza
    }

    match /solicitudesWeb/{id} {
      allow read, update, delete: if isAllowed();
      allow create: if esSolicitudValida(request.resource.data);
    }

    // ── Bloqueo por defecto (deny-all) ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
