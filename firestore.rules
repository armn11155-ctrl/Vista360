rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: usuario autenticado con email en la allowlist ──────────
    function isAllowed() {
      let emails = [
        // Agrega aquí los emails autorizados. Esto se evalúa en el servidor.
        // Para producción, considera usar Custom Claims con Firebase Admin SDK.
      ];
      return request.auth != null
        && (emails.size() == 0 || request.auth.token.email in emails);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Colecciones de negocio (solo usuarios autenticados) ────────────
    match /paneles/{id} {
      allow read, write: if isSignedIn();
    }

    match /clientes/{id} {
      allow read, write: if isSignedIn();
    }

    match /contratos/{id} {
      allow read, write: if isSignedIn();
    }

    match /gastos/{id} {
      allow read, write: if isSignedIn();
    }

    match /proveedores/{id} {
      allow read, write: if isSignedIn();
    }

    match /facturas/{id} {
      allow read, write: if isSignedIn();
    }

    match /sueldos/{id} {
      allow read, write: if isSignedIn();
    }

    // ── Bloqueo por defecto (deny-all) ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
