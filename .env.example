# Vista360 — Variables de entorno
# Copia este archivo: cp .env.example .env.local
# NO comitees .env.local (está en .gitignore)

# ── Firebase (obligatorias) ──────────────────────────────────────
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123:web:abc

# ── Emails autorizados (opcional) ────────────────────────────────
# Lista separada por comas. Vacío = sin whitelist local (usa solo Firestore)
VITE_ALLOWED_EMAILS=admin@tuempresa.com,otro@tuempresa.com

# ── Cloudinary (opcional — solo si usas carga de imágenes / OCR) ─
VITE_CLOUDINARY_CLOUD_NAME=mi-cloud
VITE_CLOUDINARY_UPLOAD_PRESET=vista360_preset

# ── Backend (opcional — OCR y facturación) ───────────────────────
VITE_API_URL=https://tu-backend.com
VITE_API_KEY=tu_clave_secreta

# ── Facturación Web (opcional) ────────────────────────────────────
# URL pública de la app facturacion-web. Si se configura, el botón
# "Nueva Factura" en Vista360 abre esta app directamente en vez de
# mostrar un mensaje informativo.
VITE_FACTURACION_WEB_URL=https://facturacion.tuempresa.com

# ── Datos del Emisor (para comprobantes PDF generados en Vista360) ─
# IMPORTANTE: Estos valores determinan qué RUC/razón social aparece
# en los comprobantes PDF que genera Vista360 y en los QR de SUNAT.
# Si el QR de tus facturas muestra un RUC incorrecto, actualiza aquí
# y también en facturacion-api/.env → EMISOR_RUC
VITE_EMISOR_RUC=20xxxxxxxxx
VITE_EMISOR_RAZON_SOCIAL=TU EMPRESA S.A.C.
VITE_EMISOR_DIRECCION=Jr. Ejemplo 123, Lima
VITE_EMISOR_CIUDAD=Lima
VITE_EMISOR_ACTIVIDAD=Publicidad Exterior
