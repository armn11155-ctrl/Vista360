# ══════════════════════════════════════════════════
# Vista360 — Variables de entorno
# Copia este archivo como .env y rellena los valores.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ══════════════════════════════════════════════════

# ── Firebase ───────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloudinary ─────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_PRESET=

# ── Emisor (datos de facturación) ──────────────────
VITE_EMISOR_RAZON_SOCIAL=
VITE_EMISOR_RUC=
VITE_EMISOR_DIRECCION=
VITE_EMISOR_CIUDAD=
VITE_EMISOR_ACTIVIDAD=
